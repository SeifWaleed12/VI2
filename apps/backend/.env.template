STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# Public address of this server; staff invite and reset emails link to <this>/app
MEDUSA_BACKEND_URL=http://localhost:9000
# Email through Resend (invites, password resets, order emails). Set both or
# neither. Without them nothing is delivered; outside production the server log
# records each send. RESEND_FROM uses a domain verified in Resend, for example
# "Vi2 <orders@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM=
# Public address of the storefront; customer password reset emails link to
# <this>/account/reset-password
STOREFRONT_URL=http://localhost:3000
# Upload storage (Cloudflare R2, or any S3-compatible bucket). Set all or none;
# none keeps uploads on this server's disk (dev only, production refuses).
# S3_FILE_URL: the bucket's public URL (r2.dev or custom domain). S3_ENDPOINT:
# https://<account-id>.r2.cloudflarestorage.com. Keys: R2 > Manage API tokens.
S3_FILE_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional; R2 uses "auto"
S3_REGION=
